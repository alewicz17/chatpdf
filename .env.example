# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server (API routes). Non esporre mai al client.
SUPABASE_SERVICE_ROLE_KEY=
# Nome del bucket di Supabase Storage per i PDF
NEXT_PUBLIC_SUPABASE_PDF_BUCKET=pdfs

# --- LLM (generazione) ---
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Embedding ---
# Usa la stessa GOOGLE_GENERATIVE_AI_API_KEY per text-embedding-004
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768
