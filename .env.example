# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server (API routes). Non esporre mai al client.
SUPABASE_SERVICE_ROLE_KEY=
# Nome del bucket di Supabase Storage per i PDF
NEXT_PUBLIC_SUPABASE_PDF_BUCKET=pdfs

# --- LLM (generazione) ---
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Modello di generazione su Groq 
GENERATION_MODEL=openai/gpt-oss-120b

# --- Embedding ---
# Usa la stessa GOOGLE_GENERATIVE_AI_API_KEY per gli embedding.
# gemini-embedding-001 produce 3072 dimensioni: EMBEDDING_DIMENSIONS le tronca a 768,
# come la colonna vector(768) e la RPC match_document_chunks.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
